# ==============================================================================
# Crove CRM (Twenty CRM Fork) - Production & Docker Environment Template
# ==============================================================================
# Ghi chú: Các biến nhạy cảm (Credentials, Secrets, Passwords) sẽ được tự động
# nạp từ GCP Secret Manager khi khởi chạy trên máy chủ GCP VM (crove-server).
# ==============================================================================

# ———————— 1. Docker & Server Core ————————
TAG=latest
NODE_ENV=production
SERVER_URL=https://crm.crove.com
FRONTEND_URL=https://crm.crove.com
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
LOGGER_DRIVER=CONSOLE
LOG_LEVELS=error,warn,log

# Secret & Encryption Keys
# [Loaded from GCP Secret: CROVE_ENCRYPTION_KEY / CROVE_APP_SECRET]
ENCRYPTION_KEY=replace_me_with_32_byte_base64_encryption_key
APP_SECRET=replace_me_with_random_app_secret

# Multi-tenancy & Workspace Preferences
SIGN_IN_PREFILLED=true
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false
IS_MULTIWORKSPACE_ENABLED=false

# ———————— 2. Database & Cache (Supabase PostgreSQL & Redis) ————————
# Supabase AWS ap-southeast-1 direct connection (Schema: core & dynamic workspace schemas)
# [Password loaded from GCP Secret: CROVE_SUPABASE_DB_PASSWORD]
PG_DATABASE_URL=postgresql://crm_app:replace_me_with_crm_app_password@db.gulptwduchsjcsbndmua.supabase.co:5432/postgres?sslmode=require
PG_SSL_ALLOW_SELF_SIGNED=false

# Internal Docker Redis for BullMQ & Caching
REDIS_URL=redis://redis:6379

# ———————— 3. Cloudflare R2 Storage (Zero-Egress Object Storage) ————————
STORAGE_TYPE=s3
STORAGE_S3_NAME=crove-crm
STORAGE_S3_REGION=auto
STORAGE_S3_ENDPOINT=https://5f2a58925e790423dfafa0e6bee46b28.r2.cloudflarestorage.com
# [Access Key & Secret loaded from GCP Secret: CLOUDFLARE_R2_ACCESS_KEY_ID & CLOUDFLARE_R2_SECRET_ACCESS_KEY]
STORAGE_S3_ACCESS_KEY_ID=eba1fe0113c4f55e1716b5a2405a7d5c
STORAGE_S3_SECRET_ACCESS_KEY=replace_me_with_cloudflare_r2_secret_access_key

# ———————— 4. DOS ID SSO & Webhook Sync (Identity Hub) ————————
AUTH_DOS_ID_ENABLED=true
AUTH_DOS_ID_CLIENT_ID=18790ccb-4d71-48cd-ad24-aee5f3ced3da
AUTH_DOS_ID_ISSUER_URL=https://gulptwduchsjcsbndmua.supabase.co/auth/v1
AUTH_DOS_ID_CALLBACK_URL=https://crm.crove.com/auth/dos-id/redirect
# [Client Secret & Webhook Secret loaded from GCP Secret: AUTH_DOS_ID_CLIENT_SECRET & CROVE_DOS_WEBHOOK_SECRET]
AUTH_DOS_ID_CLIENT_SECRET=replace_me_with_dos_id_client_secret
CROVE_DOS_WEBHOOK_SECRET=replace_me_with_dos_webhook_hmac_secret

# ———————— 5. User Mailbox & Calendar Sync (Group A) ————————
# Cho phép từng thành viên trong CRM kết nối hòm thư cá nhân (Gmail, Outlook, IMAP/SMTP) và Calendar để sync 2 chiều
IS_IMAP_SMTP_CALDAV_ENABLED=true
MESSAGING_PROVIDER_GMAIL_ENABLED=false
CALENDAR_PROVIDER_GOOGLE_ENABLED=false
MESSAGING_PROVIDER_MICROSOFT_ENABLED=false
CALENDAR_PROVIDER_MICROSOFT_ENABLED=false

# ———————— 6. System Transactional Email (Brevo / Sendinblue SMTP) ————————
# Dùng gửi mã xác thực, lời mời tham gia workspace, thông báo hệ thống
EMAIL_DRIVER=smtp
EMAIL_FROM_ADDRESS=crm@crove.com
EMAIL_FROM_NAME="Crove CRM"
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_NO_TLS=false
# [SMTP Credentials loaded from GCP Secret: BREVO_SMTP_USER & BREVO_SMTP_KEY]
EMAIL_SMTP_USER=replace_me_with_brevo_smtp_login
EMAIL_SMTP_PASSWORD=replace_me_with_brevo_smtp_master_key
IS_EMAIL_VERIFICATION_REQUIRED=false

# ———————— 7. DOS.AI AI-Native Engine (@ai-sdk/openai-compatible) ————————
# [API Key loaded from GCP Secret: DOS_AI_API_KEY]
AI_PROVIDERS='{"dos-ai":{"npm":"@ai-sdk/openai-compatible","label":"DOS.AI","baseUrl":"https://api.dos.ai/v1","apiKey":"replace_me_with_dos_ai_api_key","models":[{"name":"dos-auto","label":"DOS Auto (Smart)","contextWindowTokens":128000,"maxOutputTokens":8192}]}}'
AI_MODELS_DEFAULT_FAST=dos-ai/dos-auto
AI_MODELS_DEFAULT_SMART=dos-ai/dos-auto
AI_MODELS_DEFAULT_RECOMMENDED=dos-ai/dos-auto

# ———————— 8. Optional Observability & Additional Integrations ————————
# Sentry error tracking (Tùy chọn - Free tier 5,000 errors/tháng hoặc dùng CONSOLE logs mặc định)
EXCEPTION_HANDLER_DRIVER=CONSOLE
# SENTRY_ENVIRONMENT=production
# SENTRY_DSN=
# SENTRY_FRONT_DSN=

# People Data Labs (Bỏ trống - Chỉ bật khi muốn tự động enrich công ty/profile trả phí toàn hệ thống)
# PEOPLE_DATA_LABS_API_KEY=
